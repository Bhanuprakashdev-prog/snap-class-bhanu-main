{
  "name": "SnapClass Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "api/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y cmake ffmpeg libgl1-mesa-glx libsndfile1 && pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "uvicorn api.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "portsAttributes": {
    "8000": {
      "label": "SnapClass Gateway",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}